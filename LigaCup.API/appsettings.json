{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "LigaCupSqlite": "Data Source=App_Data/ligacup.db"
  },
  "Jwt": {
    "Issuer": "LigaCup",
    "Audience": "LigaCup.Clients",
    "Key": "",
    "ExpiryMinutes": 720
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
