<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\LigaCup.API.exe"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="OutOfProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- The SQLite database must never be downloadable over HTTP. -->
          <hiddenSegments>
            <add segment="App_Data" />
          </hiddenSegments>
          <fileExtensions>
            <add fileExtension=".db" allowed="false" />
            <add fileExtension=".db-shm" allowed="false" />
            <add fileExtension=".db-wal" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
      <webSocket enabled="true" />
    </system.webServer>
  </location>
</configuration>
